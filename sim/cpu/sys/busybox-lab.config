# busybox options for the lab-virt initramfs, applied on top of `make allnoconfig` by build_userland.sh.
# Our own text (MIT). Static, ash as /bin/sh, and a few applets for the boot test.
# SPDX-License-Identifier: MIT
CONFIG_STATIC=y
CONFIG_PLATFORM_LINUX=y
CONFIG_LONG_OPTS=y
CONFIG_ASH=y
CONFIG_SH_IS_ASH=y
CONFIG_BASH_IS_NONE=y
CONFIG_ASH_ECHO=y
CONFIG_ASH_PRINTF=y
CONFIG_ASH_TEST=y
CONFIG_FEATURE_SH_MATH=y
CONFIG_ECHO=y
CONFIG_CAT=y
CONFIG_LS=y
CONFIG_MOUNT=y
CONFIG_UNAME=y
CONFIG_MKDIR=y
CONFIG_HALT=y
CONFIG_POWEROFF=y
CONFIG_REBOOT=y
CONFIG_DMESG=y
CONFIG_SLEEP=y
CONFIG_TRUE=y
CONFIG_FREE=y
CONFIG_SYNC=y
CONFIG_UPTIME=y
